{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "opencode/big-pickle",
  "small_model": "opencode/beam-free",
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "mcp": {
    "rea": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/d",
        "/c",
        "npx",
        "-y",
        "rea-agents@6.4.0",
        "mcp"
      ],
      "enabled": true
    }
  }
}
